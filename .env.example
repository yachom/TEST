# fnpricing 환경 변수 예시
# 사용법: cp .env.example .env  후 필요한 값 채우기
# 모든 변수는 선택. 누락 시 Stub / Mock 으로 동작 (POC 기본 모드).

# ---------------------------------------------------------------------------
# LLM API 키 (provider·model 설정은 config/runtime.yaml 에서)
# ---------------------------------------------------------------------------
# .env 에는 API 키 시크릿만 넣는다.
# 어떤 provider/model 을 쓸지는 config/runtime.yaml 의 llm 섹션에서 설정한다.

# OpenAI 사용 시
# OPENAI_API_KEY=sk-...

# Anthropic / Claude 사용 시 (pip install "fnpricing[anthropic]")
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# [배포 환경 전용] LLM 설정 env override
# ---------------------------------------------------------------------------
# yaml 파일을 수정할 수 없는 환경(K8s, Docker 등)에서만 사용.
# 로컬 개발에서는 runtime.yaml 을 직접 수정하는 것이 권장된다.
#
# FNPRICING_LLM_PROVIDER=anthropic          # stub | openai | anthropic
# FNPRICING_LLM_MODEL=claude-sonnet-4-6
# FNPRICING_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
# FNPRICING_LLM_REPORT_GENERATION_MODEL=claude-opus-4-6

# ---------------------------------------------------------------------------
# 외부 데이터 API
# ---------------------------------------------------------------------------
# 네이버 검색 API (배치 뉴스 수집 — NaverNewsSearchProvider)
# 발급: https://developers.naver.com/apps/
# 단일 키:
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
#
# 다중 키 (ApiKeyRotator — 첫 키 quota 소진 시 다음 키로 자동 전환):
# NAVER_CLIENT_IDS=id1,id2,id3
# NAVER_CLIENT_SECRETS=secret1,secret2,secret3

# vworld 토지 정보 API (VworldTool — analyze-address --real-tools 사용 시 필수)
# 발급: https://www.vworld.kr/dev/v4api.do
# VWORLD_API_KEY=
# VWORLD_DOMAIN=          # 발급 시 등록한 도메인 (선택)

# 행정안전부 도로명주소 검색 API (JusoClient — VworldTool 의존)
# 주소 → PNU 변환에 사용. 발급: https://business.juso.go.kr/
# JUSO_CONFIRM_KEY=

# 국토교통부 실거래가 API (TransactionTool — 상업업무용 매매 조회)
# 발급: https://www.data.go.kr/data/15126473/openapi.do (PublicDataReader 사용)
# MOLIT_SERVICE_KEY 또는 DATA_GO_KR_SERVICE_KEY 둘 중 하나 설정.
# MOLIT_SERVICE_KEY=
# DATA_GO_KR_SERVICE_KEY=

# (Phase 4 예정 — 현재 미사용)
# BUILDING_HUB_API_KEY=   # 건축HUB (별도 발급 시)

# ---------------------------------------------------------------------------
# Observability (LLM 토큰 사용량 / agent flow 추적)
# ---------------------------------------------------------------------------
# 백엔드 선택은 config/runtime.yaml 의 observability.backend 또는 아래 env:
#   noop | stdout | langfuse
# FNPRICING_OBSERVABILITY_BACKEND=langfuse
# FNPRICING_OBSERVABILITY_STDOUT_INCLUDE_PROMPTS=false   # stdout 백엔드에서 prompt 전문 출력 여부

# Langfuse Cloud (https://cloud.langfuse.com — 무료 tier 50k events/월)
# 또는 Self-hosted: docker-compose up 후 host 만 바꾸면 됨.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com  # self-hosted 사용 시 변경

# ---------------------------------------------------------------------------
# 데이터베이스 (init-db / 영구화 작업 시)
# ---------------------------------------------------------------------------
# 기본값: sqlite:///./var/fnpricing.db
# FNPRICING_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/fnpricing
# FNPRICING_SCHEMA_VERSION=1
